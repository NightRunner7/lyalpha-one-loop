#!/bin/bash
#PBS -N accdm_upper_fit_A
#PBS -l select=1:ncpus=32:mem=32gb
#PBS -l walltime=08:00:00
#PBS -j oe
set -Eeuo pipefail
: "${PROJECT_ROOT:?Export PROJECT_ROOT from the project directory before qsub.}"
: "${PYTHON_BIN:?Export the Python executable from the working fit environment.}"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1
cd "${PROJECT_ROOT}"
arguments=(
  "${PROJECT_ROOT}/accdm_upper_grid_fit/run_upper.py"
  --project-root "${PROJECT_ROOT}"
  --phase full
  --workers 32
  --max-rounds "${MAX_ROUNDS:-12}"
  --out "${FIT_OUT:-${PROJECT_ROOT}/runs/accdm/reprofile_upper_v2/stage_A}"
  --resume
)
if [[ -n "${DATA_DIR:-}" ]]; then arguments+=(--data-dir "${DATA_DIR}"); fi
"${PYTHON_BIN}" -u "${arguments[@]}"
